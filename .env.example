# === Aplicação ===
APP_ENV=dev                       # dev | staging | prod

# === HTTP (API pública) ===
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=15s
# Origens autorizadas (CORS). O desktop usa loopback (http://127.0.0.1:<porta>); em dev um front web
# em http://localhost:5173. Em prod, a origem do app (se houver web).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# === Métricas (listener INTERNO; nunca exposto no host público) ===
# A API e o ai-worker expõem /metrics + /healthz aqui. Prometheus raspa via ServiceMonitor/PodMonitor.
METRICS_ADDR=:9090

# === Banco (Postgres) ===
DATABASE_URL=postgres://rbnotes:rbnotes@localhost:5432/rbnotes?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MIGRATE_ON_START=true

# === Redis (canal da resposta da IA em tempo real — SSE) ===
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# === Auth (Keycloak realm rbnotes) ===
# PRODUÇÃO: AUTH_MODE=oidc (default) valida iss + aud (e role, se AUTH_REQUIRED_ROLE preenchido).
#   AUTH_ISSUER=https://auth.rodolfodebonis.com.br/realms/rbnotes
#   AUTH_AUDIENCE=rbnotes-api
# DEV LOCAL: o bypass por header X-Debug-User só vale com AUTH_MODE=dev E APP_ENV=dev E AUTH_ISSUER vazio.
AUTH_MODE=dev
AUTH_ISSUER=
AUTH_AUDIENCE=rbnotes-api
AUTH_REQUIRED_ROLE=

# === MinIO (áudio das notas; S3-compatível interno) ===
# Em dev, o docker-compose sobe o MinIO com estas credenciais. Em prod, SEGREDO (Vault k3s/rbnotes/prod/minio).
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=rbnotes
MINIO_SECRET_KEY=rbnotes-dev-secret
MINIO_BUCKET=rbnotes-audio
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
# Teto por chunk de áudio (Cloudflare limita 100 MB; usamos 50 MiB).
AUDIO_CHUNK_LIMIT=52428800

# === IA (só o ai-worker usa; a API apenas enfileira e repassa a stream) ===
# Token da assinatura do Claude: gere com `claude setup-token`. SEGREDO (Vault k3s/rbnotes/prod/claude).
CLAUDE_CODE_OAUTH_TOKEN=
AI_CLAUDE_BIN=claude
# Modelo padrão (whitelist: sonnet | opus | haiku). O pedido pode pedir outro da whitelist.
AI_MODEL=sonnet
AI_JOB_TIMEOUT=6m
# Teto diário de pedidos de IA por usuário (0 = sem teto).
AI_DAILY_LIMIT=50
# HOME da CLI (~/.claude guarda as sessões do --resume do chat) e raiz dos cwd por conversa.
AI_HOME=/home/node
AI_WORKDIR=/home/node/work

# === Telemetria ===
OTEL_ENABLED=false
OTEL_SERVICE_NAME=rbnotes-api
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
LOG_LEVEL=info
